APP_NAME="Finanças Pessoais API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_financeiro_pessoal
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Gerar segredo local com: php artisan finance:jwt-secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=43200
JWT_ISSUER=financas-pessoais-api

LOG_CHANNEL=single
LOG_LEVEL=warning
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
